# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Public URL of this site (used for email confirmation / password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, server-only. Enables "Delete account" and "Confirm email" in the admin panel.
# Supabase → Settings → API Keys → Secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
